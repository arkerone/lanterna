node_modules/
# Keep the vendored fixture dependency for the node-modules-hotspot example.
!examples/node-modules-hotspot/node_modules/
!examples/node-modules-hotspot/node_modules/**
dist/
dist-test/
packages/*/dist/
packages/*/.tsbuildinfo
*.log
*.cpuprofile
.DS_Store
packages/core/src/report/version.generated.ts

# Coverage
coverage/
packages/*/coverage/

# E2E test artifacts (generated on failure; uploaded as CI artifacts, never committed)
e2e-artifacts/

# Local heap snapshots from --heap-snapshot-analysis
.lanterna-heaps/
.lanterna-heapsnapshots/

# Tooling caches
.turbo/
packages/*/.turbo/
.eslintcache

# Husky internals (managed by husky)
.husky/_/
